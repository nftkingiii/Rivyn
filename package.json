{
  "name": "rivyn",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "npm run typecheck && forge build",
    "typecheck": "tsc --noEmit",
    "test": "forge test -vvv && node --import tsx --test test-api/**/*.test.ts",
    "server": "tsx src/server.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@gluwa/usc-contracts": "0.1.2",
    "@gluwa/usc-sdk": "0.18.0",
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "6.17.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "tsx": "4.22.4",
    "typescript": "6.0.2"
  }
}
