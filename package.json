{
  "name": "rivyn",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "npm run typecheck && forge build && npm run build:web",
    "build:railway": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "forge test -vvv && node --import tsx --test test-api/**/*.test.ts",
    "server": "node --env-file=.env --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "web": "vite",
    "preview:web": "vite preview",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@gluwa/usc-contracts": "0.1.2",
    "@gluwa/usc-sdk": "0.18.0",
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "6.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.22.4",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "6.0.2",
    "vite": "8.3.5"
  }
}
